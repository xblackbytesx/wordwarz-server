DOMAIN=privacy.box
SUBDOMAIN=wordwarz
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# Image tag: a release (0.2.0), a series (0.2) or latest.
WORDWARZ_VERSION=latest

# POSTGRES
POSTGRES_DB=wordwarz
POSTGRES_USER=wordwarz
POSTGRES_PASSWORD=<INSERT_RANDOM_STRING>

# SERVER
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@wordwarz-server-db:5432/${POSTGRES_DB}
WORDWARZ_BIND=0.0.0.0:8080
RUST_LOG=info
# The address devices use; invite and device-link QR codes point here.
WORDWARZ_PUBLIC_URL=https://wordwarz.privacy.box
# UnifiedPush servers the apps may register on (comma-separated host names,
# e.g. your ntfy). Empty: no push; open apps still update by long-poll.
WORDWARZ_PUSH_HOSTS=ntfy.privacy.box
# Web login cookie is Secure (https only). Set false only for plain-http LAN use.
WORDWARZ_COOKIE_SECURE=true
