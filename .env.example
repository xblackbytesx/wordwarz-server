# For the LOCAL smoke-test stack (make up). Deployments use deploy/.env.example.
POSTGRES_PASSWORD=change-me
PORT=8080
# The address your devices use; invite and device-link QR codes point here.
# WORDWARZ_PUBLIC_URL=http://192.168.1.10:8080
# UnifiedPush servers devices may use (comma-separated host names). Empty: push off.
# WORDWARZ_PUSH_HOSTS=ntfy.example.com
# Postgres data. Relative paths resolve from docker/, so prefer absolute paths.
# WORDWARZ_DB_DIR=/absolute/path/wordwarz-server/postgres
