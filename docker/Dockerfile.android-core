# Builds wordwarz-ffi for Android (cargo-ndk) plus its Kotlin bindings: make android-core
FROM rust:1.92-bookworm

ARG NDK_VERSION=r27d
ARG CARGO_NDK_VERSION=4.1.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip" -o /tmp/ndk.zip \
    && unzip -q /tmp/ndk.zip -d /opt \
    && mv "/opt/android-ndk-${NDK_VERSION}" /opt/android-ndk \
    && rm /tmp/ndk.zip
ENV ANDROID_NDK_HOME=/opt/android-ndk

RUN rustup target add aarch64-linux-android x86_64-linux-android \
    && cargo install cargo-ndk --version "${CARGO_NDK_VERSION}" --locked

WORKDIR /app
CMD ["bash", "docker/build-android-core.sh"]
